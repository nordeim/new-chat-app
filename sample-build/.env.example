# PostgreSQL connection string (required — the app refuses to start without it).
# Local development example:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# NVIDIA NIM API key from https://build.nvidia.com (server-side only).
# Optional: without it the workspace runs and shows connection guidance instead
# of model responses. Never expose this through a NEXT_PUBLIC_ variable.
# NVIDIA_API_KEY="nvapi-..."
